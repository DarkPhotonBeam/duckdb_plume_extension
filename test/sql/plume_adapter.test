# name: test/sql/plume_adapter.test
# description: test plume_adapter extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT plume_adapter('Sam');
----
Catalog Error: Scalar Function with name plume_adapter does not exist!

# Require statement will ensure this test is run with this extension loaded
require plume_adapter

# Confirm the extension works
query I
SELECT plume_adapter('Sam');
----
...........🦆 Sam

query I
SELECT plume_adapter_openssl_version('Michael') ILIKE 'PlumeAdapter Michael, my linked OpenSSL version is OpenSSL%';
----
true
